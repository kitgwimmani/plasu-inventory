# ---------------------------------------------------------------------------
# PLASU SMIS backend environment
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Port the Node API listens on (kept on localhost, nginx proxies to it)
PORT=5000

NODE_ENV=production

# Long random string. Generate one with:  openssl rand -hex 48
JWT_SECRET=change_this_to_a_long_random_secret_in_production

JWT_EXPIRES_IN=8h

# Origin allowed to call the API via CORS. For the single-server nginx setup
# the frontend is served from the same origin, so set this to the site URL.
CLIENT_ORIGIN=http://80.241.214.47
