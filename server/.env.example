# ---------------------------------------------------------------------------
# PLASU SMIS backend environment
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Port the Node API listens on (kept on localhost, nginx proxies to it)
PORT=5000

NODE_ENV=production

# Long random string. Generate one with:  openssl rand -hex 48
JWT_SECRET=change_this_to_a_long_random_secret_in_production

JWT_EXPIRES_IN=8h

# Origin allowed to call the API via CORS. For the single-server nginx setup
# the frontend is served from the same origin, so set this to the site URL.
# Also used as the base URL in notification e-mails.
CLIENT_ORIGIN=http://80.241.214.47

# ---------------------------------------------------------------------------
# E-mail notifications (optional). If SMTP_HOST / SMTP_USER / SMTP_PASS are not
# all set, e-mail is silently disabled and only in-app (bell) notifications
# are sent. Requisition feedback (submitted / recommended / rejected /
# approved / issued) is e-mailed to the requester (and new submissions to the
# Head of Store).
# ---------------------------------------------------------------------------
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false            # "true" only for port 465
# SMTP_USER=notifications@plasu.edu.ng
# SMTP_PASS=your_app_password
# SMTP_FROM=PLASU SMIS <notifications@plasu.edu.ng>
# MAIL_ENABLED=true            # set "false" to force-disable
